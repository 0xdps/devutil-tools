{
    "compilerOptions": {
        "noEmit": true,
        "types": ["node"],
        "skipLibCheck": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "strict": true
    },
    "include": [
        "vite.config.ts",
        "vite-plugins/**/*.ts",
        "src/tools/catalog.ts",
        "src/tools/seo-head.ts"
    ]
}